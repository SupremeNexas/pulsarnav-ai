# PulsarNav AI — Production Environment Variables

# Set to 'true' to call the live API endpoints (FastAPI or Serverless routes).
# Set to 'false' to utilize the client-side RK4 physics engine as an autonomous fallback.
NEXT_PUBLIC_USE_LIVE_API=false

# URL of the production backend REST API.
NEXT_PUBLIC_API_URL=https://api.pulsarnav-ai.space
